[ext_resource type="Script" uid="uid://bv4f4ro53gt2w" path="res://script/dialogue.gd" id="1_6kon1"]
[ext_resource type="Script" uid="uid://ctq32uuxm8kma" path="res://script/dialogue_group.gd" id="2_jvj8y"]
[ext_resource type="Texture2D" uid="uid://b21664fraidx3" path="res://sprite/小恶魔_flip.png" id="3_m6qw6"]

[sub_resource type="Resource" id="Resource_6kon1"]
script = ExtResource("1_6kon1")
text = "嗯，感觉精神了不少。"
name = "你"
show_on_left = false
metadata/_custom_type_script = "uid://bv4f4ro53gt2w"

[sub_resource type="Resource" id="Resource_aie1e"]
script = ExtResource("1_6kon1")
text = "不过怎么感觉身体怪怪的。"
name = "你"
show_on_left = false
metadata/_custom_type_script = "uid://bv4f4ro53gt2w"

[sub_resource type="AtlasTexture" id="AtlasTexture_devil"]
atlas = ExtResource("3_m6qw6")
region = Rect2(0, 0, 16, 25)

[sub_resource type="Resource" id="Resource_qnd15"]
script = ExtResource("1_6kon1")
text = "汝啊，那可不是错觉~"
name = "小恶魔"
texture = SubResource("AtlasTexture_devil")
show_on_left = false
metadata/_custom_type_script = "uid://bv4f4ro53gt2w"

[sub_resource type="Resource" id="Resource_6kf1g"]
script = ExtResource("1_6kon1")
text = "誓约已成，现在汝获得了咖啡恶魔——也就是咱的权能，喝下咖啡就能获得对应的能力。"
name = "小恶魔"
texture = SubResource("AtlasTexture_devil")
show_on_left = false
metadata/_custom_type_script = "uid://bv4f4ro53gt2w"

[sub_resource type="Resource" id="Resource_s2u52"]
script = ExtResource("1_6kon1")
text = "至于代价嘛...汝会对咖啡产生严重的依赖症状。也就是说，离开了咖啡就没法活下去..."
name = "小恶魔"
texture = SubResource("AtlasTexture_devil")
show_on_left = false
metadata/_custom_type_script = "uid://bv4f4ro53gt2w"

[sub_resource type="Resource" id="Resource_3hv1k"]
script = ExtResource("1_6kon1")
text = "...?"
name = "你"
show_on_left = false
metadata/_custom_type_script = "uid://bv4f4ro53gt2w"

[sub_resource type="Resource" id="Resource_nops2"]
script = ExtResource("1_6kon1")
text = "汝看起来完全没能理解现状呐。无妨，待会汝就知道了。而且现在对汝来讲更重要的是去上班呗。"
name = "小恶魔"
texture = SubResource("AtlasTexture_devil")
show_on_left = false
metadata/_custom_type_script = "uid://bv4f4ro53gt2w"

[sub_resource type="Resource" id="Resource_jvj8y"]
script = ExtResource("1_6kon1")
text = "也是，全勤要紧。"
name = "你"
show_on_left = false
metadata/_custom_type_script = "uid://bv4f4ro53gt2w"

[sub_resource type="Resource" id="Resource_alkch"]
script = ExtResource("1_6kon1")
text = "呼呼~"
name = "小恶魔"
texture = SubResource("AtlasTexture_devil")
show_on_left = false
metadata/_custom_type_script = "uid://bv4f4ro53gt2w"

